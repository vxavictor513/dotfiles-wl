# Desired state for this machine — not a version lockfile.
# Add entries with: brew bundle add <formula>  /  brew bundle add --cask <cask>
# Runtimes (node/python/java) are owned by mise, not Homebrew.

# --- Dotfiles plumbing ---
# Distributed revision control system
brew "git"
# Organize software neatly under a single directory (symlink farm manager)
brew "stow"
# Polyglot runtime manager (node/python/java versions)
brew "mise"
# Mac App Store command-line interface
brew "mas"

# --- Shell & CLI ---
# Cat clone with syntax highlighting and Git integration
brew "bat"
# Improved shell history for zsh, bash, fish and nushell
brew "atuin"
# Modern, maintained replacement for ls
brew "eza"
# Simple, fast and user-friendly alternative to find
brew "fd"
# Command-line fuzzy finder written in Go
brew "fzf"
# Programmatically correct mistakes in diffs (delta)
brew "git-delta"
# Simple terminal UI for git commands
brew "lazygit"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Shell extension to navigate your filesystem faster
brew "zoxide"

# --- Project dependency tooling ---
# AI agent toolkit (Pi); pulls in Homebrew node as a dependency only
brew "pi-coding-agent"
# Fast, disk space efficient package manager (Node)
brew "pnpm"
# Extremely fast Python package installer and resolver
brew "uv"

# --- Containers (Colima: open-source, no commercial licence needed) ---
# Container runtimes on MacOS (and Linux) with minimal setup
brew "colima"
# Pack, ship and run any application as a lightweight container
brew "docker"
# Docker CLI plugin for extended build capabilities with BuildKit
brew "docker-buildx"
# Isolated development environments using Docker
brew "docker-compose"

