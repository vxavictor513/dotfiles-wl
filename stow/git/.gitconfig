# Generic git config. Tracked in ~/dotfiles-wl via Stow.
# Identity (name, email, signingkey) goes in ~/.gitconfig.local (untracked).

[init]
    defaultBranch = main

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[merge]
    conflictStyle = zdiff3

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true

# Keep last so local values override the above.
[include]
    path = ~/.gitconfig.local
